# ---------------------------------------------------------------------------
# Orivell. Copy to .env.local and fill in. Only DATABASE_URL and the AI_* trio
# are required; everything else degrades gracefully when missing.
# ---------------------------------------------------------------------------

# Postgres on Neon. Create the tables with `npm run db:migrate`.
# Backs sync, accounts and the graph.
DATABASE_URL=

# Any OpenAI-compatible endpoint. Examples:
#   DeepSeek  https://api.deepseek.com/v1
#   GLM       https://open.bigmodel.cn/api/paas/v4
#   Qwen      https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama    http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Official Together channel. Optional once AI_BASE_URL is set: server-side
# requests go to your own endpoint, while a visitor's own pasted key still
# goes to Together.
TOGETHER_API_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# How often a reader's shelf pulls for changes, in milliseconds. 5000 is
# responsive; raise it (30000) when many readers share one database — each
# reader pulls on this timer, so the query load scales with it.
NEXT_PUBLIC_SYNC_INTERVAL_MS=5000

# Optional: Clerk as a second way to sign in. Without it the built-in
# email/password accounts are used.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional: Exa web search, for fact-check and questions asked with Web on.
# Without it answers stay inside the text.
EXA_API_KEY=

# Optional: password-reset mail via Resend. Without it, reset is done
# server-side with a script.
RESEND_API_KEY=
RESEND_FROM=

# Optional: guards the daily-review cron endpoint.
CRON_SECRET=

# Optional: eyes for scanned PDF pages and generated covers.
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# Optional: LlamaParse, behind "read it more carefully" on hard PDFs.
LLAMA_CLOUD_API_KEY=

# Optional: MediaCrawler sidecar for Chinese platforms behind a login wall.
GLOSS_CNSPIDER_URL=http://127.0.0.1:8899
